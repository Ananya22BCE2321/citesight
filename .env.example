# API Keys for different providers
# Get your keys from the respective platforms

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your-google-gemini-api-key-here

# NVIDIA (https://build.nvidia.com/)
NVIDIA_API_KEY=your-nvidia-api-key-here

# SerpAPI for SERP analysis (https://serpapi.com/)
SERPAPI_API_KEY=your-serpapi-key-here

# Optional: Override default settings
PIPELINE_PROVIDER=google
PIPELINE_MODEL=gemini-1.5-flash
PIPELINE_MAX_WORKERS=5
PIPELINE_MAX_TOKENS=500
PIPELINE_TEMPERATURE=0.7
PIPELINE_RETRIES=3
PIPELINE_RATE_LIMIT_RPM=60
PIPELINE_COST_TRACKING=true
PIPELINE_BUDGET_CAP=5.0